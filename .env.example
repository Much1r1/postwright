# LLM Provider Configuration (groq | gemini | anthropic)
LLM_PROVIDER=groq
# Choose a model that supports structured output (e.g. llama-3.3-70b-versatile for groq, gemini-2.5-flash for gemini, claude-3-5-sonnet-20241022 for anthropic)
LLM_MODEL=llama-3.3-70b-versatile

# Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Judge LLM Settings (for milestone 7 evaluation)
JUDGE_PROVIDER=groq
JUDGE_MODEL=llama-3.3-70b-versatile

# Rate Limiting & Resilience
MAX_LLM_RETRIES=3
# Optional client-side throttle (calls per minute, leave unset/blank for off)
MAX_LLM_CALLS_PER_MINUTE=

# Runtime mode: 0 for dry-run (default), 1 for live publishing
POSTWRIGHT_LIVE=0

# Observability / LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=postwright
